  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "GPIO4_Play")
  (net 4 "GPIO5_Cut")
  (net 5 "GPIO6_Undo")
  (net 6 "GPIO7_Save")
  (net 7 "GPIO15_Custom1")
  (net 8 "GPIO16_Custom2")
  (net 9 "GPIO8_SDA")
  (net 10 "GPIO9_SCL")
  (net 11 "GPIO17_LED")

  (junction (at 100 100) (diameter 0) (color 0 0 0 0))

  (wire (pts (xy 50 100) (xy 100 100)) (stroke (width 0.254)) (uuid "wire-001"))

  (text "BUTTON SECTION\n\nSW1 → GPIO4 (Play/Pause)\nSW2 → GPIO5 (Cut)\nSW3 → GPIO6 (Undo)\nSW4 → GPIO7 (Save)\nSW5 → GPIO15 (Custom 1)\nSW6 → GPIO16 (Custom 2)\n\nAll buttons connect to GND when pressed\nFirmware uses internal pull-ups" (at 50 150 0) (effects (font (size 1.27 1.27) (thickness 0.15))))

  (text "ESP32-S3 DEVELOPMENT BOARD\n(Placeholder - Model TBD)\n\nPower:\n  - 3.3V Rail → All VCC/3.3V inputs\n  - GND Rail → All GND inputs\n\nGPIO Assignments (Preliminary):\n  GPIO4 - Button 1 (Play/Pause)\n  GPIO5 - Button 2 (Cut)\n  GPIO6 - Button 3 (Undo)\n  GPIO7 - Button 4 (Save)\n  GPIO15 - Button 5 (Custom 1)\n  GPIO16 - Button 6 (Custom 2)\n  GPIO8 - I2C SDA (OLED)\n  GPIO9 - I2C SCL (OLED)\n  GPIO17 - LED Control (active high)\n  \nUSB Connection:\n  - USB-C for programming and power" (at 300 150 0) (effects (font (size 1.27 1.27) (thickness 0.15))))

  (text "OLED DISPLAY (I2C)\n0.96\", 128x64 pixels\nSSD1306 Controller\n\nConnections:\n  VCC → +3.3V (verify module supports 3.3V)\n  GND → GND Rail\n  SDA → GPIO8\n  SCL → GPIO9\n  I2C Address: 0x3C (default)" (at 800 150 0) (effects (font (size 1.27 1.27) (thickness 0.15))))

  (text "STATUS LED CIRCUIT\n\nLED1 (Red, 5mm)\n  Anode (+) → R1 (220Ω) → GPIO17\n  Cathode (-) → GND\n\nResistor Calculation:\n  Typical red LED: Vf = 2.0V\n  GPIO 3.3V - 2.0V = 1.3V\n  Current (15mA): R = 1.3V / 0.015A ≈ 87Ω\n  Use 220Ω for lower brightness (~6mA)" (at 600 500 0) (effects (font (size 1.27 1.27) (thickness 0.15))))

  (text "PROTOTYPE VALIDATION CHECKLIST\n\n☐ Confirm exact ESP32-S3 development board model\n☐ Verify GPIO pin assignments against official datasheet\n☐ Check OLED module 3.3V compatibility (some require 5V)\n☐ Measure actual LED forward voltage for final resistor value\n☐ Test button debouncing (firmware pull-up + debounce routine)\n☐ Verify I2C bus pull-up resistor requirements (OLED module may include them)\n☐ Simulate circuit in EDA tool before PCB layout\n☐ Perform ERC (Electrical Rule Check) on final schematic\n☐ Validate power consumption and thermal performance\n☐ Document any changes to GPIO assignments in firmware" (at 50 700 0) (effects (font (size 1.27 1.27) (thickness 0.15))))

)
